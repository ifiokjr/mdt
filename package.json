{
	"name": "@m-d-t/root",
	"private": true,
	"type": "module",
	"description": "Monorepo root for mdt npm packages",
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ifiokjr/mdt.git"
	},
	"scripts": {
		"check": "tsgo -config tsconfig.json",
		"fmt": "oxfmt --write \"**/*.ts\"",
		"fmt:check": "oxfmt --check \"**/*.ts\"",
		"lint": "oxlint --type-aware .",
		"lint:syntax": "oxlint .",
		"build": "tsdown"
	},
	"devDependencies": {
		"@rslint/tsgo": "^0.7.3",
		"@types/node": "^26.6.4",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10"
	}
}
