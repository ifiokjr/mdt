{
	"name": "@m-d-t/root",
	"private": true,
	"type": "module",
	"description": "Monorepo root for mdt npm packages",
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ifiokjr/mdt.git"
	},
	"scripts": {
		"check": "tsgo -config tsconfig.json",
		"fmt": "oxfmt --write \"**/*.ts\"",
		"fmt:check": "oxfmt --check \"**/*.ts\"",
		"lint": "oxlint --type-aware .",
		"lint:syntax": "oxlint .",
		"build": "tsdown",
		"site:build": "tsx scripts/site/build.ts"
	},
	"devDependencies": {
		"@rslint/tsgo": "^0.7.3",
		"@types/node": "^26.6.5",
		"marked": "^18.1.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"shiki": "^4.5.0",
		"tsdown": "^0.23.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10"
	}
}
