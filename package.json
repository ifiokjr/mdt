{
	"name": "@m-d-t/root",
	"private": true,
	"type": "module",
	"description": "Monorepo root for mdt npm packages",
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ifiokjr/mdt.git"
	},
	"scripts": {
		"check": "tsgo -config tsconfig.json",
		"fmt": "oxfmt --write \"**/*.ts\"",
		"fmt:check": "oxfmt --check \"**/*.ts\"",
		"lint": "oxlint --type-aware .",
		"lint:syntax": "oxlint .",
		"build": "tsdown"
	},
	"devDependencies": {
		"@rslint/tsgo": "^0.7.3",
		"@types/node": "^26.2.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10"
	}
}
